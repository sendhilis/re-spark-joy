# =============================================================================
# Lipafo Switch — Bank Pilot Environment Template
# Copy this file to `.env` and fill in the bank-side values.
# =============================================================================

# --- Service ---
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# --- Redis (idempotency + circuit-breaker state) ---
# When using docker-compose this is already wired to the redis service.
REDIS_URL=redis://redis:6379

# --- Downstream Bank (KCB BUNI sandbox during pilot) ---
# Base URL of the bank's Daraja-pattern OAuth2 + payment endpoints.
BANK_BASE_URL=https://uat.buni.kcbgroup.com
BANK_CLIENT_ID=replace-with-bank-issued-client-id
BANK_CLIENT_SECRET=replace-with-bank-issued-client-secret

# Hard timeout on the credit leg (ms). FTS v3.0 §5 mandates 8s.
BANK_CALL_TIMEOUT_MS=8000

# --- Idempotency ---
IDEMPOTENCY_TTL_SECONDS=86400

# --- Async confirmation callback (webhook.site or bank-hosted) ---
LIPAFO_CALLBACK_URL=https://webhook.site/d49ac2e7-1e20-4353-a103-3813945d3d76
